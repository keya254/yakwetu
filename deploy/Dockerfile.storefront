# Multi-stage: build React SPA, serve with nginx + API proxies
FROM node:20-alpine AS build
WORKDIR /src
COPY storefront/package.json storefront/package-lock.json ./
RUN npm ci
COPY storefront/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/nginx-storefront.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
