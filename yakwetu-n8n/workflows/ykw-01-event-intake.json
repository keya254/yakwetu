      "id": "2132f950-5770-4812-8ac0-4226ed2f5a7f",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2340,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const ev = $('Normalize & Validate').first().json;\nconst atUsername = String($env.AT_USERNAME || '').trim();\nconst atApiKey = String($env.AT_API_KEY || '').trim();\nconst atSenderId = String($env.AT_SENDER_ID || '').trim();\nif (!atUsername || !atApiKey || !atSenderId) {\n  throw new Error(\"Africa's Talking SMS requires AT_USERNAME, AT_API_KEY, and AT_SENDER_ID on the n8n container\");\n}\nconst storefront = (typeof $env !== 'undefined' && $env.STOREFRONT_URL ? $env.STOREFRONT_URL : 'https://yakwetu.dontire.com').replace(/\\/$/, '');\nconst title = ev.movie_title || 'your movie';\nconst price = ev.price_kes != null ? `KES ${ev.price_kes}` : '';\nconst watch = `${storefront}/watch.html?m=${encodeURIComponent(ev.movie_id || '')}&title=${encodeURIComponent(title)}&genre=${encodeURIComponent(ev.genre || '')}`;\nconst name = (ev.name || 'there').split(' ')[0];\nconst full_message = `Hi ${name}! Payment received for ${title}${price ? ' (' + price + ')' : ''}. You're all set \u2014 watch now: ${watch}`;\nreturn [{ json: { ...ev, watch_link: watch, full_message } }];"
      },
      "id": "a11a0010-build-payment-sms",
      "name": "Build Payment SMS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AT_API_URL || 'https://api.africastalking.com/version1/messaging' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apiKey",
