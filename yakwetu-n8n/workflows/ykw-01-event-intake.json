    {
      "parameters": {
        "jsCode": "const ev = $('Normalize & Validate').first().json;\nreturn [{ json: {\n  status: 'ok',\n  event: 'demo_abandon',\n  session_id: ev.session_id,\n  user_id: ev.user_id,\n  hint: 'Session stored as already idle 50 min (no wait)'\n}}];"
      },
      "id": "a11a0021-build-demo-abandon-ok",
      "name": "Build Demo Abandon OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        420
