      "id": "797db09c-45d9-488a-97b1-c8b036f1d172",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "yakwetu-event"
    },
    {
      "parameters": {
        "jsCode": "// Yakwetu event contract — normalize incoming events from web/app\nconst b = $json.body || $json;\nconst required = ['event_type', 'user_id'];\nfor (const r of required) {\n  if (!b[r]) throw new Error(`Missing required field: ${r}`);\n}\nconst VALID = ['signup','browse','checkout_start','payment_failed','payment_success','watch_complete'];\nif (!VALID.includes(b.event_type)) throw new Error('Unknown event_type: ' + b.event_type);\n\nreturn [{ json: {\n  event_type: b.event_type,\n  user_id: String(b.user_id),\n  name: b.name || '',\n  phone: String(b.phone || '').replace(/\\s/g,''),\n  email: b.email || '',\n  session_id: b.session_id || ('sess_' + Date.now()),\n  movie_id: b.movie_id || null,\n  movie_title: b.movie_title || null,\n  genre: b.genre || null,\n  price_kes: b.price_kes || null,\n  failure_reason: b.failure_reason || null,\n  channel_pref: b.channel_pref || 'sms',\n  ts: b.ts || new Date().toISOString()\n}}];"
      },
      "id": "d4773697-1b41-48ba-ae06-3e68587104b3",
      "name": "Normalize & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO users (user_id, name, phone, email, channel_pref, last_seen)\nVALUES ($1,$2,$3,$4,$5, NOW())\nON CONFLICT (user_id) DO UPDATE SET\n  name = COALESCE(NULLIF(EXCLUDED.name,''), users.name),\n  phone = COALESCE(NULLIF(EXCLUDED.phone,''), users.phone),\n  email = COALESCE(NULLIF(EXCLUDED.email,''), users.email),\n  channel_pref = COALESCE(EXCLUDED.channel_pref, users.channel_pref),\n  last_seen = NOW()\nRETURNING user_id;",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.name, $json.phone, $json.email, $json.channel_pref] }}"
        }
      },
      "id": "5fd82043-2624-4d40-8354-b124dcc21483",
      "name": "Upsert User",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [680, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Yakwetu Postgres"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Postgres replace $json — restore the normalized event for downstream nodes\nconst ev = $('Normalize & Validate').first().json;\nreturn [{ json: { ...ev } }];"
      },
      "id": "a11a0001-restore-after-upsert",
      "name": "Restore Event After Upsert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [790, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO events (user_id, session_id, event_type, movie_id, movie_title, genre, price_kes, failure_reason, ts)\nVALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9::timestamptz);\nINSERT INTO sessions (session_id, user_id, state, last_activity, last_movie_id, last_movie_title, last_genre, last_price)\nVALUES ($2,$1,\n  CASE $3 WHEN 'checkout_start' THEN 'checkout' WHEN 'payment_success' THEN 'purchased' WHEN 'payment_failed' THEN 'failed' ELSE 'browsing' END,\n  NOW(), $4,$5,$6,$7)\nON CONFLICT (session_id) DO UPDATE SET\n  state = CASE $3 WHEN 'checkout_start' THEN 'checkout' WHEN 'payment_success' THEN 'purchased' WHEN 'payment_failed' THEN 'failed' ELSE sessions.state END,\n  last_activity = NOW(),\n  last_movie_id = COALESCE($4, sessions.last_movie_id),\n  last_movie_title = COALESCE($5, sessions.last_movie_title),\n  last_genre = COALESCE($6, sessions.last_genre),\n  last_price = COALESCE($7, sessions.last_price),\n  recovered = CASE WHEN $3='payment_success' THEN true ELSE sessions.recovered END\nRETURNING session_id;",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.session_id, $json.event_type, $json.movie_id, $json.movie_title, $json.genre, $json.price_kes, $json.failure_reason, $json.ts] }}"
        }
      },
      "id": "db3d9314-8033-4e6c-99ae-b1d935b2f498",
      "name": "Log Event",
