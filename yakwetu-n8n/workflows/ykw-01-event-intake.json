    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE nudges SET converted = true, converted_at = NOW()\nWHERE user_id = $1 AND converted = false\n  AND sent_at > NOW() - INTERVAL '72 hours'\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.user_id] }}"
        }
      },
