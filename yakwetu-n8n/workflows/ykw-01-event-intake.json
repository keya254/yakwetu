                "conditions": [
                  {
                    "id": "r-demo-abandon",
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "demo_abandon",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
