{
  "name": "YKW 03 — Payment Failure Rescue",
  "nodes": [
    {
      "parameters": {},
      "id": "0ed5762f-80be-4890-b14b-9fb02cd2521e",
      "name": "When Called by Intake",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Triage the Daraja-style failure reason into a recovery strategy\nconst reason = ($json.failure_reason || '').toLowerCase();\nlet klass = 'generic', strategy = 'retry_steps';\nif (reason.includes('insufficient') || reason.includes('balance')) { klass = 'insufficient_funds'; strategy = 'smaller_bundle'; }\nelse if (reason.includes('pin') || reason.includes('authorisation')) { klass = 'wrong_pin'; strategy = 'pin_help'; }\nelse if (reason.includes('timeout') || reason.includes('cancelled') || reason.includes('canceled')) { klass = 'timeout_or_cancel'; strategy = 'fresh_stk'; }\nelse if (reason.includes('limit')) { klass = 'limit_exceeded'; strategy = 'till_or_card'; }\nreturn [{ json: { ...$json, failure_class: klass, strategy } }];"
      },
      "id": "0991cb7e-8ca6-424b-b2ed-ea2d2cb98cdc",
      "name": "Classify Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are Yakwetu support — a Kenyan movie streaming platform. A customer's M-Pesa payment just failed. Write a warm, reassuring SMS (max 320 chars) that (1) says no money was lost / any deduction reverses automatically, (2) gives the exact fix for their failure class, (3) keeps the movie they wanted front and center. Return JSON only: {\"message\": \"...\"}"
            },
            {
              "role": "user",
              "content": "=Customer {{ $json.name || 'viewer' }}, movie: {{ $json.movie_title }} (KES {{ $json.price_kes }}). Failure class: {{ $json.failure_class }}. Strategy: {{ $json.strategy }}. If strategy=smaller_bundle mention they can grab the 24-hour rental instead. If pin_help remind them to enter M-Pesa PIN on the phone prompt. If fresh_stk say we'll send a fresh prompt. If till_or_card suggest paying via card instead."
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.6
        }
      },
      "id": "cfa1d331-90ef-4a2a-898d-82fa6e20e19a",
      "name": "AI: Troubleshooting Copy",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [
        680,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "2",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let ai;\ntry { ai = JSON.parse($json.message?.content || $json.text || '{}'); }\ncatch(e) { ai = { message: 'Pole! Your payment did not go through — no money was lost. Want us to send a fresh M-Pesa prompt?' }; }\nconst storefront = (typeof $env !== 'undefined' && $env.STOREFRONT_URL ? $env.STOREFRONT_URL : 'http://localhost:8080').replace(/\\/$/, '');\nconst link = `${storefront}/checkout.html?resume=${$json.session_id}&retry=1`;\nreturn [{ json: { ...$('Classify Failure').first().json, ai_message: ai.message,\n  full_message: `${ai.message}\\n\\n▶️ Resume payment: ${link}` } }];"
      },
      "id": "a2f485a7-fd9a-4b23-8042-a68a6a221fd8",
      "name": "Build Rescue Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AT_API_URL || 'https://api.africastalking.com/version1/messaging' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apiKey",
              "value": "={{ $env.AT_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ $env.AT_USERNAME }}"
            },
            {
              "name": "to",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "message",
              "value": "={{ $json.full_message }}"
            },
            {
              "name": "from",
              "value": "={{ $env.AT_SENDER_ID }}"
            }
          ]
        },
        "options": {}
      },
      "id": "503c0282-22b6-496e-82cb-b66bb5258295",
      "name": "Instant SMS (Africa's Talking)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO nudges (user_id, session_id, scenario, channel, message, sent_at)\nVALUES ($1,$2,'payment_failed','sms',$3,NOW());\nINSERT INTO dropoffs (user_id, session_id, movie_id, failure_class, ts)\nVALUES ($1,$2,$4,$5,NOW());",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.session_id, $json.full_message, $json.movie_id, $json.failure_class] }}"
        }
      },
      "id": "b56e379c-8ff4-4670-9ed4-dcee955d9d1c",
      "name": "Log Drop-off",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1340,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Yakwetu Postgres"
        }
      }
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "hours"
      },
      "id": "28504911-1127-4b93-a3d8-31a2ae0ebdc8",
      "name": "Wait 2 Hours",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
