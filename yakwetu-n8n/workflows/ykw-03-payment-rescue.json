        "query": "SELECT recovered FROM sessions WHERE session_id = $1;",
        "options": {
          "queryReplacement": "={{ [$('Classify Failure').first().json.session_id] }}"
        }
      },
      "id": "39bb4712-25a8-4c0e-aabe-da1ef44006b6",
