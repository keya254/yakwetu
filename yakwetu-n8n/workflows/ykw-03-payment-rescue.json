              "value": "={{ $('Classify Failure').first().json.phone }}"
            },
            {
              "name": "message",
              "value": "=Still want {{ $('Classify Failure').first().json.movie_title }}? Use code PONA10 for 10% off — valid tonight only 🎬 {{ $env.STOREFRONT_URL }}/checkout.html?resume={{ $('Classify Failure').first().json.session_id }}"
            },
            {
              "name": "from",
              "value": "={{ $env.AT_SENDER_ID }}"
            }
          ]
        },
        "options": {}
      },
      "id": "260d3947-3011-4d86-a6c8-c84fa1a22958",
      "name": "SMS: Incentive Nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO nudges (user_id, session_id, scenario, channel, message, sent_at)\nVALUES ($1,$2,'payment_failed_incentive','sms','PONA10 incentive sent',NOW());\nUPDATE sessions SET nudge_count = nudge_count + 1, last_nudge_at = NOW() WHERE session_id = $2;",
        "options": {
          "queryReplacement": "={{ [$('Classify Failure').first().json.user_id, $('Classify Failure').first().json.session_id] }}"
        }
      },
