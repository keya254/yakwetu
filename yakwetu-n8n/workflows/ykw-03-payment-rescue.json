      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO nudges (user_id, session_id, scenario, channel, message, sent_at)\nVALUES ($1,$2,'payment_failed','sms',$3,NOW());\nINSERT INTO dropoffs (user_id, session_id, movie_id, failure_class, ts)\nVALUES ($1,$2,$4,$5,NOW());",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.session_id, $json.full_message, $json.movie_id, $json.failure_class] }}"
