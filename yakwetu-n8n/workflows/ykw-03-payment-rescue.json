              "value": "=Still want {{ $('Classify Failure').first().json.movie_title }}? Use code PONA10 for 10% off \u2014 valid tonight only \ud83c\udfac {{ $env.STOREFRONT_URL }}/checkout.html?resume={{ $('Classify Failure').first().json.session_id }}"
            },
