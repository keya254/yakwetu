        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ $env.AT_USERNAME }}"
            },
            {
              "name": "to",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "message",
              "value": "={{ $json.full_message }}"
            },
            {
              "name": "from",
              "value": "={{ $env.AT_SENDER_ID }}"
            },
            {
              "name": "bulkSMSMode",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "id": "503c0282-22b6-496e-82cb-b66bb5258295",
      "name": "Instant SMS (Africa's Talking)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
