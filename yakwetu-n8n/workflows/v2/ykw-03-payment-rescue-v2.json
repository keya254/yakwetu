      "parameters": {
        "promptType": "define",
        "text": "=First name: {{ $json.firstName }}\nFilm: {{ $json.title }}\nWhat went wrong: {{ $json.reason }}\nWhat to suggest: {{ $json.strategy }}\nPrice: KES {{ $json.totalKes }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You write one SMS for a viewer whose payment for a film just failed on Yakwetu Sinema, a Kenyan pay-per-film store. Help them finish. Rules: at most 110 characters. Warm, plain Kenyan English (a little Swahili like 'Pole' or 'Karibu' is fine). Use only the facts given: never invent a film, price, discount or deadline. Mention the price only if given, exactly as given. No links, no emojis, no hashtags; the link is added after your message. End so the link reads naturally after it (e.g. end with 'Tap:' or 'here:')."
            }
          ]
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Credential: attach your OpenAI credential on the model below (gpt-4o-mini).",
      "notesInFlow": true
    },
