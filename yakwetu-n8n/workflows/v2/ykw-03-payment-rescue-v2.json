    {
      "id": "e1248245-7227-44cc-a918-b73f9584b0a8",
      "name": "AI: troubleshooting copy · parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
