        }
      }
    },
    {
      "id": "2ad100ba-8bf4-4ec3-a2c9-de0341e83777",
      "name": "AI: build the bundle offer · parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2780,
        -40
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"message\": \"Pole Wanjiku, the M-Pesa prompt for Supa Modo timed out. Tap when your phone's ready:\"\n}"
      }
    },
    {
      "id": "79f1284f-ed6e-481f-9585-2c0d94c0d306",
      "name": "Guard the copy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        -240
      ],
      "parameters": {
        "jsCode": "const facts = $(\"Upsell facts\").first().json;\nconst ai = $input.first().json ?? {};\nconst text = String(ai.output?.message ?? ai.text ?? \"\").trim();\nlet fallbackReason = null;\nif (!text)\n    fallbackReason = ai.error ? \"AI error\" : \"no AI answer\";\nelse if (text.length > 120)\n    fallbackReason = \"too long\";\nelse if (/https?:|www\\.|\\.com|\\.app/i.test(text))\n    fallbackReason = \"contains a link\";\nelse {\n    const prices = [...text.matchAll(/KES\\s?([\\d,]+)/gi)].map((match) => Number(match[1].replace(/,/g, \"\")));\n    if (prices.some((price) => price !== facts.totalKes))\n        fallbackReason = \"wrong price\";\n}\nconst body = fallbackReason ? facts.fallback : text;\nreturn [{ json: { ...facts, message: `${body} ${facts.url}`.trim(), aiUsed: !fallbackReason, fallbackReason } }];"
      }
    },
