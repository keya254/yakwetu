    {
      "id": "fcaa732b-2bfe-4ffb-ac81-41bf11f84019",
      "name": "Give them tonight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const DEMO = true;\nconst DEMO_DELAY_MINUTES = 2;\nconst OPEN = 15;\nconst CLOSE = 21;\nconst now = new Date();\nif (DEMO) {\n    return [{ json: { ...$input.first().json, sendAt: new Date(now.getTime() + DEMO_DELAY_MINUTES * 60_000).toISOString(), demo: true } }];\n}\n// Tomorrow's window, at a random minute within its first hour (spreads the load).\nconst nairobi = new Date(now.toLocaleString(\"en-US\", { timeZone: \"Africa/Nairobi\" }));\nconst offset = now.getTime() - nairobi.getTime();\nconst tomorrow = new Date(nairobi.getFullYear(), nairobi.getMonth(), nairobi.getDate() + 1, OPEN, Math.floor(Math.random() * 60));\nvoid CLOSE;\nreturn [{ json: { ...$input.first().json, sendAt: new Date(tomorrow.getTime() + offset).toISOString(), demo: false } }];"
      }
    },
