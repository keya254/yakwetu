    {
      "id": "c44460d8-b59e-4818-8e4a-51ecb358819a",
      "name": "Upsell facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -240
      ],
      "parameters": {
        "jsCode": "const info = $(\"Order & viewer (storefront)\").first().json;\nconst bundle = $(\"Pick the bundle\").first().json;\nconst link = $input.first().json;\nconst titles = link.films.map((film) => film.title);\nconst first = info.user.firstName;\nreturn [\n    {\n        json: {\n            userId: info.user.id,\n            phone: info.user.phone,\n            firstName: first,\n            boughtTitle: bundle.boughtTitle,\n            genre: bundle.boughtGenres[0] ?? \"film\",\n            pickTitles: titles,\n            totalKes: link.totalKes,\n            discountPct: link.discountPct,\n            url: link.url,\n            nudgeId: link.nudgeId,\n            movieIds: link.films.map((film) => film.id),\n            alternative: \"\",\n            fallback: `Loved ${bundle.boughtTitle}, ${first}? ${titles.join(\" + \")}: KES ${link.totalKes} (${link.discountPct}% off) this week:`,\n        },\n    },\n];"
      }
    },
    {
      "id": "d7e1e55b-7363-4714-95ef-65ea3c44b3fa",
      "name": "AI: build the bundle offer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        2640,
        -240
      ],
      "parameters": {
        "promptType": "define",
        "text": "=First name: {{ $json.firstName }}\nThey bought: {{ $json.boughtTitle }} ({{ $json.genre }})\nSuggested next: {{ $json.pickTitles.join(' and ') }}\nBundle price: KES {{ $json.totalKes }} ({{ $json.discountPct }}% off)",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You write one SMS to a viewer who just bought a film on Yakwetu Sinema, a Kenyan pay-per-film store, suggesting what to watch next as a bundle. Rules: at most 110 characters. Warm, plain Kenyan English (a little Swahili like 'Pole' or 'Karibu' is fine). Use only the facts given: never invent a film, price, discount or deadline. Mention the price only if given, exactly as given. No links, no emojis, no hashtags; the link is added after your message. End so the link reads naturally after it (e.g. end with 'Tap:' or 'here:')."
            }
          ]
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Credential: attach your OpenAI credential on the model below (gpt-4o-mini).",
      "notesInFlow": true
    },
    {
      "id": "2daa8a1f-db49-4164-8682-bede0021f283",
      "name": "AI: build the bundle offer · model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
