    {
      "id": "c44460d8-b59e-4818-8e4a-51ecb358819a",
      "name": "Upsell facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -240
      ],
      "parameters": {
        "jsCode": "const info = $(\"Order & viewer (storefront)\").first().json;\nconst bundle = $(\"Pick the bundle\").first().json;\nconst link = $input.first().json;\nconst films = Array.isArray(link.films) ? link.films : [];\nconst titles = films.map((film) => film.title);\nconst first = (info.user && info.user.firstName) || 'there';\nconst poster = (films[0] && (films[0].poster || films[0].posterUrl || films[0].image)) || '';\nconst bundleTitle = titles.join(' + ');\nreturn [{\n  json: {\n    userId: info.user.id,\n    phone: info.user.phone,\n    email: info.user.email || '',\n    name: (info.user && info.user.name) || first,\n    channelPref: info.user.channelPref || info.user.channel_pref || 'both',\n    subject: `Since you watched ${bundle.boughtTitle} \u2014 ${bundleTitle}`,\n    scenario: 'C_upsell',\n    firstName: first,\n    boughtTitle: bundle.boughtTitle,\n    filmTitle: bundle.boughtTitle,\n    genre: bundle.boughtGenres[0] ?? \"film\",\n    pickTitles: titles,\n    bundleTitle,\n    totalKes: link.totalKes,\n    priceKes: link.totalKes,\n    discountPct: link.discountPct,\n    url: link.url,\n    ctaUrl: link.url,\n    ctaLabel: 'Unlock this bundle',\n    imageUrl: poster,\n    films,\n    nudgeId: link.nudgeId,\n    movieIds: films.map((film) => film.id),\n    alternative: \"\",\n    fallback: `Loved ${bundle.boughtTitle}, ${first}? Keep going with ${bundleTitle} \u2014 KES ${link.totalKes} (${link.discountPct}% off) this week:`,\n  },\n}];"
      }
    },
    {
      "id": "79f1284f-ed6e-481f-9585-2c0d94c0d306",
      "name": "Guard the copy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        -240
      ],
      "parameters": {
        "jsCode": "const facts = $(\"Upsell facts\").first().json;\nconst ai = $input.first().json ?? {};\nconst text = String(ai.output?.message ?? ai.text ?? \"\").trim();\nlet fallbackReason = null;\nif (!text)\n    fallbackReason = ai.error ? \"AI error\" : \"no AI answer\";\nelse if (text.length > 120)\n    fallbackReason = \"too long\";\nelse if (/https?:|www\\.|\\.com|\\.app/i.test(text))\n    fallbackReason = \"contains a link\";\nelse {\n    const prices = [...text.matchAll(/KES\\s?([\\d,]+)/gi)].map((match) => Number(match[1].replace(/,/g, \"\")));\n    if (prices.some((price) => price !== facts.totalKes))\n        fallbackReason = \"wrong price\";\n}\nconst body = fallbackReason ? facts.fallback : text;\nreturn [{ json: { ...facts, message: `${body} ${facts.url}`.trim(), aiUsed: !fallbackReason, fallbackReason } }];"
      }
    },
