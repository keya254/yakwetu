            {
              "name": "X-Title",
              "value": "Yakwetu Sinema"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: ($env.OPENROUTER_MODEL || 'openai/gpt-4o-mini'), temperature: 0.7, max_tokens: 120, response_format: { type: 'json_object' }, messages: [{ role: 'system', content: \"You write one SMS upsell after a Yakwetu purchase. Return JSON {\\\"message\\\": \\\"...\\\"}. Max 110 chars. Warm. Use only given facts. No links/emojis. End ready for an offer link.\" },{ role: 'user', content: 'First name: ' + String($json.firstName||'') + '\\n' + 'Bought: ' + String($json.boughtTitle||'') + '\\nGenre: ' + String($json.genre||'') + '\\nBundle: ' + (Array.isArray($json.pickTitles)?$json.pickTitles.join(' + '):String($json.pickTitles||'')) + '\\nPrice: KES ' + String($json.totalKes) + ' (' + String($json.discountPct) + '% off)' }] }) }}",
        "options": {
          "timeout": 25000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "1786c3bd-4aff-469b-9c2c-ba26b3d72443",
      "name": "Parse OpenRouter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        -240
      ],
      "parameters": {
        "jsCode": "let message = '';\ntry {\n  const raw = $input.first().json || {};\n  const content = raw.choices?.[0]?.message?.content || raw.message || '';\n  if (typeof content === 'string' && content.trim().startsWith('{')) {\n    const parsed = JSON.parse(content);\n    message = String(parsed.message || parsed.text || '').trim();\n  } else {\n    message = String(content || '').trim();\n  }\n} catch (e) { message = ''; }\nreturn [{ json: { output: { message }, text: message } }];"
      }
    },
