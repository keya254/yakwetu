      "id": "6c49e116-6f17-483b-85b8-80fd437f017f",
      "name": "Write the last call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4320,
        -320
      ],
      "parameters": {
        "jsCode": "const sent = $(\"Guard the copy\").first().json;\nconst titles = Array.isArray(sent.pickTitles) ? sent.pickTitles.join(\" + \") : (sent.bundleTitle || 'your bundle');\nconst message = `Last call, ${sent.firstName}: ${titles} at KES ${sent.totalKes} ends soon \u2014 ${sent.url}`;\nreturn [{ json: {\n  ...sent,\n  scenario: 'C_last_call',\n  subject: `Last call: ${titles} offer ending soon`,\n  message,\n  filmTitle: sent.boughtTitle || sent.filmTitle,\n  bundleTitle: titles,\n  ctaLabel: 'Get it before it expires',\n  badge: 'Ending soon',\n}}];"
      }
    },
