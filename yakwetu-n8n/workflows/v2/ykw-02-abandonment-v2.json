      ],
      "parameters": {
        "queue": "q.n8n.checkout-abandoned",
        "options": {
          "acknowledge": "executionFinishesSuccessfully",
          "jsonParseBody": true,
          "onlyContent": true,
          "parallelMessages": 5
        }
      },
      "credentials": {
        "rabbitmq": {
          "id": "0XUkvX0FdyyHYkKN",
          "name": "RabbitMQ account"
        }
      }
