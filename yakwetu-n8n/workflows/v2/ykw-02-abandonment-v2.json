    {
      "id": "33ddaae1-5b6d-4b99-a46c-d7cd448ddce3",
      "name": "Offer facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -160
      ],
      "parameters": {
        "jsCode": "const info = $(\"Order & viewer (storefront)\").first().json;\nconst bundle = $(\"Build the bundle\").first().json;\nconst link = $input.first().json;\nconst [cart, extra] = link.films;\nconst first = info.user.firstName;\nreturn [\n    {\n        json: {\n            userId: info.user.id,\n            orderId: info.order.id,\n            phone: info.user.phone,\n            firstName: first,\n            cartTitle: cart.title,\n            pickTitle: extra?.title ?? null,\n            pickReason: bundle.pick?.why?.matchedGenres?.length ? `also ${bundle.pick.why.matchedGenres.join(\", \")}` : (bundle.pick?.reason ?? null),\n            totalKes: link.totalKes,\n            discountPct: link.discountPct,\n            url: link.url,\n            nudgeId: link.nudgeId,\n            movieIds: link.films.map((film) => film.id),\n            alternative: \"\",\n            fallback: extra\n                ? `${first}, ${cart.title} is still waiting. Get it with ${extra.title} for KES ${link.totalKes} (${link.discountPct}% off), next hour only:`\n                : `${first}, ${cart.title} is still waiting: KES ${link.totalKes} (${link.discountPct}% off) for the next hour:`,\n        },\n    },\n];"
      }
    },
    {
      "id": "26a2360a-1fb3-4701-aeba-2f69fa6b5fb0",
      "name": "AI: personalise the nudge",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        2640,
        -160
      ],
      "parameters": {
        "promptType": "define",
        "text": "=First name: {{ $json.firstName }}\nFilm in their cart: {{ $json.cartTitle }}\nPaired film (may be empty): {{ $json.pickTitle }}\nWhy it's paired: {{ $json.pickReason }}\nBundle price: KES {{ $json.totalKes }} ({{ $json.discountPct }}% off)\nOffer ends: in 1 hour",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You write one SMS to bring back a viewer who opened checkout on Yakwetu Sinema, a Kenyan pay-per-film store, but didn't pay. Make the offer tempting and specific. Rules: at most 110 characters. Warm, plain Kenyan English (a little Swahili like 'Pole' or 'Karibu' is fine). Use only the facts given: never invent a film, price, discount or deadline. Mention the price only if given, exactly as given. No links, no emojis, no hashtags; the link is added after your message. End so the link reads naturally after it (e.g. end with 'Tap:' or 'here:')."
            }
          ]
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Credential: attach your OpenAI credential on the model below (gpt-4o-mini).",
      "notesInFlow": true
    },
    {
      "id": "bacf7290-c082-41bc-bc52-2f9b0541c909",
