        }
      }
    },
    {
      "id": "7cc1f705-76e6-4137-b8b5-e29e84175599",
      "name": "AI: personalise the nudge · parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2780,
        40
