      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"message\": \"Pole Wanjiku, the M-Pesa prompt for Supa Modo timed out. Tap when your phone's ready:\"\n}"
      }
    },
    {
      "id": "3fe59104-f9c2-46c5-8dfd-4dbb36045503",
      "name": "Guard the copy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        -160
      ],
      "parameters": {
        "jsCode": "const facts = $(\"Offer facts\").first().json;\nconst ai = $input.first().json ?? {};\nconst text = String(ai.output?.message ?? ai.text ?? \"\").trim();\nlet fallbackReason = null;\nif (!text)\n    fallbackReason = ai.error ? \"AI error\" : \"no AI answer\";\nelse if (text.length > 120)\n    fallbackReason = \"too long\";\nelse if (/https?:|www\\.|\\.com|\\.app/i.test(text))\n    fallbackReason = \"contains a link\";\nelse {\n    const prices = [...text.matchAll(/KES\\s?([\\d,]+)/gi)].map((match) => Number(match[1].replace(/,/g, \"\")));\n    if (prices.some((price) => price !== facts.totalKes))\n        fallbackReason = \"wrong price\";\n}\nconst body = fallbackReason ? facts.fallback : text;\nreturn [{ json: { ...facts, message: `${body} ${facts.url}${facts.alternative ?? \"\"}`.trim(), aiUsed: !fallbackReason, fallbackReason } }];"
      }
    },
