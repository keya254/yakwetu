generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Everything here lives in the `storefront` schema (see DATABASE_URL). The same
// Postgres holds n8n's tables in `public` and the recommender's in `recs`;
// this app never touches either.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth — better-auth's required shape. Field names are fixed by the adapter;
// only @@map, @@index and additionalFields (phone) are ours.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// E.164 (+2547…). Where n8n sends SMS nudges through Africa's Talking.
  phone String?

  sessions Session[]
  accounts Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog — OMDb metadata cached locally, so pages never wait on (or burn the
// daily quota of) the OMDb API. Filled by `pnpm catalog:seed`.
// ─────────────────────────────────────────────────────────────────────────────

model Movie {
  /// Our slug, e.g. `nairobi-half-life`. Shared with sinema-recs for overlapping titles.
  id         String   @id
  imdbId     String?  @unique
  title      String
  year       Int?
  /// "Drama, Thriller" from OMDb, split and lowercased.
  genres     String[] @default([])
  languages  String[] @default([])
  countries  String[] @default([])
  plot       String   @default("")
  director   String?
  actors     String[] @default([])
  runtimeMin Int?
  rated      String?
  imdbRating Float?
  posterUrl  String?

  youtubeId  String?

  priceKes     Int     @default(99)
  isNewRelease Boolean @default(false)
  /// Lower is hotter. Curated for now; later derived from recent events.
  trendingRank Int?
  /// Kenyan titles get their own row on the landing page.
  featured     Boolean @default(false)

  omdbFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([trendingRank])
  @@map("movie")
}

// ─────────────────────────────────────────────────────────────────────────────
// Events — the transactional outbox. Every captured event is written here
// first; a drain loop publishes it to RabbitMQ and stamps publishedAt. If the
// broker is down, or the process dies between the write and the publish, the
// row waits and goes out later. Nothing is lost.
// ─────────────────────────────────────────────────────────────────────────────

model EventOutbox {
  /// The event id (uuid). Also the AMQP messageId, so consumers can dedupe.
  id          String    @id
  type        String
  exchange    String
  /// The full envelope, exactly as it will be published.
  payload     Json
  occurredAt  DateTime
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  /// A drain claims rows until this time; a crashed drain's claim simply expires.
  lockedUntil DateTime?
  lastError   String?

  @@index([publishedAt, createdAt])
  @@map("event_outbox")
}

model Order {
  id          String    @id @default(cuid())
  userId      String
  movieIds    String[]
  subtotalKes Int
  discountKes Int       @default(0)
  totalKes    Int
  /// open | paid | expired
  status      String    @default("open")
  /// The nudge (resume or cart link) that brought the viewer here, for attribution.
  nudgeId     String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Payment[]

  @@index([userId, createdAt])
  @@map("order")
}


model Payment {
  reference       String    @id
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  amountKes       Int
  /// created | pending | succeeded | failed | abandoned
  status          String    @default("created")
  /// mobile_money | card | …, as Paystack reports it
  channel         String?
  gatewayResponse String?
  /// Classified: insufficient_funds | wrong_pin | timeout_or_cancel | limit_exceeded | declined | amount_mismatch | init_error
  failureReason   String?
  paystackId      String?
  accessCode      String?
  /// This order was already paid by another payment: flag for refund.
  duplicate       Boolean   @default(false)
  /// How many delayed checks have looked at it (RabbitMQ payment.check).
  checks          Int       @default(0)
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
  @@index([userId, createdAt])
  @@map("payment")
}


model PaymentWebhook {
  id          String    @id
  event       String
  reference   String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, receivedAt])
  @@map("payment_webhook")
}

/// A film the viewer may watch. One row per viewer and film, so paying twice
/// never unlocks twice.
model Entitlement {
  userId      String
  movieId     String
  reference   String
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  lastWatchedAt DateTime?

  @@id([userId, movieId])
  @@index([reference])
  @@map("entitlement")
}

/// A message n8n sent with a link back to checkout (payment rescue, abandoned
/// checkout, post-watch…). The link carries a signed token for this row, so
/// n8n can't invent a price and a forwarded link can't be reused: the discount
/// lives here, the link works once, and it expires. When a payment from it
/// succeeds, settlement marks it converted in the same transaction.
model Nudge {
  id          String    @id @default(cuid())
  userId      String
  /// A (abandoned checkout) | B (payment rescue) | C (post-watch) | welcome
  scenario    String
  /// Which step of the scenario (first message, incentive…).
  step        String    @default("first")
  channel     String    @default("sms")
  movieIds    String[]
  /// The order this nudge resumes (Scenario B), if any.
  orderId     String?
  discountPct Int       @default(0)
  code        String?
  message     String?
  expiresAt   DateTime
  openedAt    DateTime?
  convertedAt DateTime?
  revenueKes  Int?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@map("nudge")
}
