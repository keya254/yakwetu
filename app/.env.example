# Copy to .env (git-ignored).

# OMDb — free key at https://www.omdbapi.com/apikey.aspx (1,000 requests/day).
# Only `pnpm catalog:seed` calls OMDb; pages read the cached copy in Postgres.
OMDB_API_KEY=

# Neon. The app owns schema "storefront"; sinema-recs shares the database in "recs".
# Runtime uses the pooled endpoint, migrations the direct one (no "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full&schema=storefront"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=verify-full&schema=storefront"
DATABASE_SCHEMA=storefront

# better-auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# sinema-recs (recommendations). Leave either empty to run without them:
# pages fall back to the plain catalog rows.
RECS_API_URL=https://3-226-65-199.sslip.io
RECS_API_KEY=
RECS_TIMEOUT_MS=1500
