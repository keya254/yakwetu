# Copy to .env for local docker-compose.dev.yml, or set the same names in
# Dokploy → Environment. Nothing sensitive belongs in docker-compose.yml.

# --- Public URLs (Dokploy / production) ---
STOREFRONT_URL=
N8N_HOST=
N8N_PROTOCOL=
WEBHOOK_URL=
N8N_EDITOR_BASE_URL=
# Behind Dokploy/Traefik (fixes "Lost connection to the server")
N8N_PROXY_HOPS=1
N8N_PUSH_BACKEND=sse
# Internal only (Compose DNS) — leave as-is on Dokploy
N8N_EVENT_WEBHOOK=

# --- Local overrides (docker-compose.dev.yml) ---
# STOREFRONT_URL=http://localhost:8080
# N8N_HOST=localhost
# N8N_PROTOCOL=http
# WEBHOOK_URL=http://localhost:5678/
# STOREFRONT_PORT=8080
# N8N_PORT=5678
# POSTGRES_PORT=5433
# PAYSTACK_API_PORT=3001

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=

# Admin dashboard (/admin.html) — OTP only to ADMIN_PHONE
ADMIN_TOKEN=yakwetu-admin
ADMIN_PHONE=+254702846542
POSTGRES_DB=
# External TCP publish (Dokploy VPS / docker-compose.yml). Use a strong password.
# Connect: host=<server-ip or yakwetu.dontire.com>  port=15432  sslmode=prefer
POSTGRES_PUBLISH_PORT=
# Local compose.dev already maps POSTGRES_PORT (default 5433)
POSTGRES_PORT=

# --- n8n ---
# MUST be set and stable across redeploys (credentials are encrypted with this)
N8N_ENCRYPTION_KEY=

# --- OpenRouter (AI nudge / rescue / upsell copy) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Africa's Talking SMS (primary channel) ---
# Live POST https://api.africastalking.com/version1/messaging
# Auth: header apiKey=AT_API_KEY; form username=AT_USERNAME, from=AT_SENDER_ID, to, message
# Sandbox: AT_USERNAME=sandbox and AT_API_URL=https://api.sandbox.africastalking.com/version1/messaging
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=AFTKNG
AT_API_URL=https://api.africastalking.com/version1/messaging

# --- Paystack ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=KES
# Dashboard webhook: https://yakwetu.dontire.com/api/paystack/webhook
# Events: charge.success, charge.failed

# --- Movie posters (optional — free keys) ---
# TMDB: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb / IMDb posters: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Without keys, /api/catalog/enrich still tries Wikipedia thumbnails

# =============================================================================
# n8n UI credentials (not env vars):
#   Postgres host = yakwetu-db   port = 5432   user/db/pass = POSTGRES_* above
#   SMTP (email upsell only) — AI uses OPENROUTER_API_KEY; SMS uses AT_*
# Storefront settings bar → webhook base = https://n8n.yakwetu.dontire.com
# =============================================================================
